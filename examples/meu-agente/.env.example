# --- IA ---------------------------------------------------------------
# ollama | openai | anthropic | google | compatible
AI_PROVIDER=compatible
# "compatible" = qualquer gateway OpenAI-compatible (LiteLLM, vLLM, Groq...)
AI_BASE_URL=https://litellm.exemplo.com/v1
AI_API_KEY=
AI_MODEL=cloud/llama-8b
AI_TEMPERATURE=0.4

# --- Telegram ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# --- Agendamento ------------------------------------------------------
CRON_INGESTION=*/30 * * * *
CRON_DIGEST=0 11 * * *

# --- Coleta -----------------------------------------------------------
DB_PATH=./data/store.db
MAX_ITEMS_PER_FEED=20
DIGEST_MAX_ITEMS=12
FEED_TIMEOUT_MS=12000
