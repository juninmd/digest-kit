{
  "name": "@juninmd/digest-kit",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Núcleo dos agentes de digest: RSS → SQLite → IA → Telegram. O agente vira um arquivo de tópico.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juninmd/digest-kit.git"
  },
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "bun": "./src/core.ts",
      "default": "./dist/core.js"
    }
  },
  "files": ["src", "dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "example": "bun run examples/meu-agente/src/index.ts",
    "bench": "bun run bench/run.ts",
    "bench:compare": "bun run bench/compare.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  }
}
